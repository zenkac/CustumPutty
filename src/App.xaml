    <SolidColorBrush x:Key="AccentInk" Color="#102D29"/>
    <SolidColorBrush x:Key="HoverLine" Color="#536577"/>
    <SolidColorBrush x:Key="InputHover" Color="#415367"/>
    <SolidColorBrush x:Key="Selection" Color="#35685F"/>
    <SolidColorBrush x:Key="Hover" Color="#2A3C4E"/>
    <SolidColorBrush x:Key="Selected" Color="#25423F"/>
