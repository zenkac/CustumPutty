      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Grid><Border x:Name="body" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="iconColumn" Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="arrowColumn" Width="16"/></Grid.ColumnDefinitions><ContentPresenter x:Name="icon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/><Path x:Name="check" Data="M 1,5 L 4,8 L 10,2" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" Visibility="Collapsed" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/><TextBlock x:Name="gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muted}" Margin="28,0,3,0" FontSize="11" VerticalAlignment="Center"/><Path x:Name="arrow" Grid.Column="3" Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource Muted}" StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed"/></Grid></Border>
